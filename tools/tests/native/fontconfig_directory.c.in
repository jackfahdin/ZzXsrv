/* Exercise Fontconfig's actual Windows directory wrapper with real Win32 I/O. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fontconfig/fontconfig.h>
#include "fcwindows.h"
#define FcPrivate
#define FC_DIR_SEPARATOR '\\'

@DIRECTORY_IMPLEMENTATION@

int main(int argc, char **argv)
{
    DIR *dir;
    struct dirent *entry;
    int count = 0, i;
    if (argc != 3) return 2;
    errno = 0;
    dir = FcCompatOpendirWin32(argv[2]);
    if (!strcmp(argv[1], "missing") || !strcmp(argv[1], "not-directory")) {
        if (dir) { FcCompatClosedirWin32(dir); return 3; }
        if (errno != (!strcmp(argv[1], "missing") ? ENOENT : EACCES)) {
            fprintf(stderr, "unexpected errno=%d\n", errno);
            return 4;
        }
        printf("PASS %s\n", argv[1]);
        return 0;
    }
    if (!dir) { fprintf(stderr, "open failed errno=%d\n", errno); return 5; }
    if (!strcmp(argv[1], "independent")) {
        DIR *other;
        char saved[MAX_PATH];
        entry = FcCompatReaddirWin32(dir);
        if (!entry) return 6;
        strcpy(saved, entry->d_name);
        other = FcCompatOpendirWin32(argv[2]);
        if (!other) return 7;
        while (FcCompatReaddirWin32(other)) if (++count > 1024) return 8;
        FcCompatClosedirWin32(other);
        if (strcmp(saved, entry->d_name)) return 9;
        FcCompatClosedirWin32(dir);
        puts("PASS independent");
        return 0;
    }
    while ((entry = FcCompatReaddirWin32(dir)) != NULL) {
        if (++count > 1024) return 10;
        printf("ENTRY\t%d\t%s\n", entry->d_type, entry->d_name);
    }
    for (i = 0; i < 3; ++i) if (FcCompatReaddirWin32(dir)) return 11;
    if (FcCompatClosedirWin32(dir) != 0) return 12;
    puts("PASS list");
    return 0;
}
